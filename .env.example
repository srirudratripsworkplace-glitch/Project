# Optional public API URL for the Vercel frontend; leave unset for local development.
# VITE_API_BASE_URL=https://api.example.com

# Node.js API service settings. Never prefix these with VITE_.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://user:password@host:5432/database
# Generate this value with npm run hash:admin-password.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
TRUST_PROXY=false
PG_POOL_MAX=10

# Optional notification integrations.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_API_VERSION=
